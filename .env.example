# MySQL on ai.thegarchagroup.com (container reaches host MySQL via host.docker.internal)
DATABASE_URL=mysql+pymysql://rpm_user:CHANGE_ME_STRONG_PASSWORD@host.docker.internal:3306/maxwell_rpm?charset=utf8mb4

SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

DEFAULT_ADMIN_EMAIL=admin@maxwell.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
DEFAULT_INSPECTOR_EMAIL=inspector@maxwell.com
DEFAULT_INSPECTOR_PASSWORD=CHANGE_ME
DEFAULT_RPM_EMAIL=rpm@maxwell.com
DEFAULT_RPM_PASSWORD=CHANGE_ME

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_NAMESPACE_ID=
